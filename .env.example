# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# AI failover (all optional)
#
# Gemini is ALWAYS the primary provider. The providers below are only used
# automatically when Gemini returns a transient error: 429 rate-limit,
# 500/502/503/504 overload or temporary server errors, 529 overloaded_error,
# request timeouts and network resets. A provider is activated by its API key
# alone - leave the key unset and it is skipped entirely.
# ---------------------------------------------------------------------------

# Gemini model cascade (tried in order before any other provider).
# GEMINI_MODEL="gemini-3.8-flash"
# GEMINI_FALLBACK_MODELS="gemini-3.7-flash,gemini-3.5-flash,gemini-2.5-flash"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com"

# Order of the non-Google providers. Any provider without a key is ignored.
# AI_FALLBACK_PROVIDER_ORDER="openrouter,groq,openai,anthropic"

# OpenRouter (OpenAI compatible, one key for many models)
# OPENROUTER_API_KEY=""
# OPENROUTER_MODELS="openai/gpt-4o-mini"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Groq (OpenAI compatible, very fast text generation)
# GROQ_API_KEY=""
# GROQ_MODELS="llama-3.3-70b-versatile"
# GROQ_BASE_URL="https://api.groq.com/openai/v1"

# OpenAI (text; audio transcription only if OPENAI_AUDIO_MODEL is also set)
# OPENAI_API_KEY=""
# OPENAI_MODELS="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_AUDIO_MODEL=""

# Anthropic
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODELS="claude-3-5-haiku-latest"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# Retry / timeout tuning
# AI_MAX_RETRIES_PER_TARGET="1"       # retries on the same provider+model
# AI_RETRY_BASE_MS="400"
# AI_RETRY_MAX_MS="4000"
# AI_RETRY_JITTER="true"
# AI_REQUEST_TIMEOUT_MS="45000"       # per text attempt
# AI_AUDIO_TIMEOUT_MS="120000"        # per transcription attempt
# AI_TOTAL_BUDGET_MS="120000"         # whole chain, text endpoints
# AI_AUDIO_TOTAL_BUDGET_MS="240000"   # whole chain, transcription endpoint

# Circuit breaker: after N consecutive transient failures a target is skipped
# for a while so an overloaded provider does not slow every request down.
# AI_COOLDOWN_ENABLED="true"
# AI_COOLDOWN_THRESHOLD="3"
# AI_COOLDOWN_MS="30000"

# Escape hatch: "true" restores the legacy behaviour (primary Gemini model
# only, no failover). The static fallbacks in server.ts are unaffected.
# DISABLE_AI_FAILOVER="false"

# Server port (defaults to 3000).
# PORT="3000"
